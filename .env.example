# Shared by the Vercel runtime and local CLI when publishing directly.
DATABASE_URL=postgresql://user:password@host/database?sslmode=require

# GitHub OAuth application used by /admin.
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
ADMIN_GITHUB_ID=90720459
AUTH_ORIGIN=https://your-domain.example
AUTH_SECRET=replace-with-at-least-32-random-characters

# Safe local-only shortcut for Playwright/development. Ignored in production.
ADMIN_DEV_BYPASS=false

# Used by the CLI after a successful direct database sync.
REVALIDATE_URL=https://your-domain.example/api/revalidate
REVALIDATE_SECRET=

# Shared by the Vercel runtime and local CLI when publishing directly.
DATABASE_URL=postgresql://user:password@host/database?sslmode=require

# Canonical public origin used by metadata, Open Graph, robots.txt and sitemap.xml.
SITE_URL=https://your-project.vercel.app

# GitHub OAuth application used by /admin.
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
ADMIN_GITHUB_ID=90720459
AUTH_ORIGIN=https://your-domain.example
AUTH_SECRET=replace-with-at-least-32-random-characters

# Safe local-only shortcut for Playwright/development. Ignored in production.
ADMIN_DEV_BYPASS=false

# Used by the CLI after a successful direct database sync.
REVALIDATE_URL=https://your-domain.example/api/revalidate
REVALIDATE_SECRET=

# Public contact form. Telegram is primary; Resend is the fallback channel.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# The sender must belong to a domain verified in Resend.
RESEND_API_KEY=
CONTACT_FROM_EMAIL=NickRaspy Portfolio <onboarding@resend.dev>
CONTACT_TO_EMAIL=you@gmail.com

# Cloudflare Turnstile. Local development falls back to Cloudflare's official
# always-pass test keys; set real keys in Vercel Preview and Production.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

{
  "name": "nickraspy-portfolio",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "db:migrate": "tsx scripts/database-migrate.ts",
    "content:validate": "tsx scripts/content.ts validate",
    "content:migrate": "npm run db:migrate",
    "content:sync": "tsx scripts/content.ts sync",
    "content:history": "tsx scripts/content.ts history",
    "content:rollback": "tsx scripts/content.ts rollback",
    "telegram:chats": "node --env-file=.env.local scripts/telegram-chats.mjs",
    "test": "npm run test:unit",
    "test:unit": "tsx --test --test-concurrency=1 \"src/**/*.test.ts\" \"tests/unit/**/*.test.ts\"",
    "test:e2e": "playwright test",
    "verify": "npm run lint && npm run typecheck && npm run test:unit && npm run build",
    "verify:e2e": "npm run verify && npm run test:e2e"
  },
  "dependencies": {
    "ajv": "^8.20.0",
    "next": "^16.2.11",
    "postgres": "^3.4.9",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "read-excel-file": "^9.3.3"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.0",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "^16.2.10",
    "fflate": "^0.8.3",
    "tailwindcss": "^4",
    "tsx": "^4.23.1",
    "typescript": "^5"
  },
  "overrides": {
    "postcss": "8.5.22",
    "sharp": "0.35.3"
  }
}
